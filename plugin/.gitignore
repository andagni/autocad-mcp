# Release-source metadata is whitelist-only. Packaging excludes every
# .gitignore file even when it is required to govern the source checkout.
/*
!/.claude-plugin/
!/.gitignore
!/.lsp.json
!/.mcp.json
!/dependency-license-policy.json
!/dependency-license-provenance.json
!/dependency-source-lock.spdx.json
!/dependency-windows-source-closure.spdx.json
!/dependency-license-supplements/
!/CHANGELOG.md
!/LICENSE
!/THIRD_PARTY_LICENSES.txt
!/skills/

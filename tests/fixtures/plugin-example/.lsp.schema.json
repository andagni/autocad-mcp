{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoCAD-MCP plugin LSP configuration",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["command", "args", "extensionToLanguage", "transport"],
    "properties": {
      "command": {
        "type": "string",
        "minLength": 1
      },
      "args": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "extensionToLanguage": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^\\.[A-Za-z0-9._+-]+$"
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      },
      "transport": {
        "type": "string",
        "enum": ["stdio", "socket"]
      }
    }
  }
}

# Rust crate source and reviewed runtime registries only.
/*
!/.gitignore
!/Cargo.toml
!/build.rs
!/profile-registry/
!/resources/
!/src/
!/tests/

/profile-registry/**
!/profile-registry/title-block-profiles.json

/resources/**
!/resources/activation-profiles/
!/resources/activation-profiles/*.arg
!/resources/activation-profiles/*.policy.json
!/resources/autocad-activation-catalogue.json
!/resources/xref-bind-verifier-profiles.json
!/resources/xref-clip-verifier-profiles.json
!/resources/xref-mutation-capabilities.json
!/resources/xref-preservation-verifier-profiles.json

/src/**
!/src/**/
!/src/*.rs
!/src/**/*.rs

/tests/**
!/tests/**/
!/tests/*.rs
!/tests/**/*.rs
